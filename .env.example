# OpenAI
OPENAI_API_KEY=sk-...

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Used by the browser to upload PDFs directly to Storage (see
# lib/supabase-browser.js). Safe to expose to the client -- the anon key
# only gets what the Storage policies in supabase/schema.sql grant it
# (insert-only on the "pdfs" bucket).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Shared password for the /admin section (no user accounts)
ADMIN_PASSWORD=choose-a-strong-password
