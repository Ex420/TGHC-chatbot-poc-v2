# OpenAI
OPENAI_API_KEY=sk-...

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared password for the /admin section (no user accounts)
ADMIN_PASSWORD=choose-a-strong-password
